# Protection spécifique du répertoire PROJET_TM
Options -Indexes

# Blocage direct des scripts PHP de configuration / helpers internes
<FilesMatch "^(config\.php|JWT\.php|JwtHandler\.php|auth_guard\.php)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
